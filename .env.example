# Copy this file to .env and fill in your own values. NEVER upload .env to GitHub.
PORT=3000
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/maintenance
# Set to true only when the database requires SSL (e.g. Render EXTERNAL database URL)
DATABASE_SSL=false
# Comma-separated list of frontend addresses allowed to call the API from a browser (Activity 8)
CLIENT_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
